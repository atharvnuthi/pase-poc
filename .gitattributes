# O repositório é montado dentro de containers Linux (e é o REPO_PATH que o
# Executor clona). Arquivos com CRLF quebram ali: script .sh vira
# "bad interpreter: /bin/bash^M" e o Makefile perde os alvos.
* text=auto eol=lf

*.sh      text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
*.py      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.md      text eol=lf

# binários - nunca normalizar
*.png binary
*.jpg binary
*.ico binary
*.patch -text
