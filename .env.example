LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MODEL_EXPLORATORY=claude-sonnet-4-6
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
DATABASE_URL=postgresql+psycopg://pase:pase@db:5432/pase
REPO_PATH=/workspace/repo
# Calibrado por medição com text-embedding-3-small (ver README): positivos ficam
# entre 0.69 e 0.90, negativos abaixo de 0.65. O 0.85 original do SPEC-01 §4 está
# acima de todos os positivos - com ele a Memória Histórica nunca barra nada.
SIMILARITY_THRESHOLD=0.72
BUDGET_TOLERANCE=0.3
# Piso do teto de custo por tarefa (ver comentário em common/config.py)
BUDGET_MIN_TOKENS=800000
MAX_RETRIES=1
MAX_LOCAL_FIX=4
COHERENCE_MAX_ADJUSTMENTS=2
DEMO_MODE=true
# Autores autorizados a abrir Sugestão de Engenharia, separados por vírgula (SPEC-03 §4)
ENGINEERING_AUTHORS=PASE Audit,Atharv
CLIENT_API_URL=http://client-backend:8001
NEXT_PUBLIC_CORE_URL=http://localhost:8000
NEXT_PUBLIC_CLIENT_API_URL=http://localhost:8001

# Chave usada pelo provider de embeddings quando ele difere do provider de chat.
# Se EMBEDDING_PROVIDER == LLM_PROVIDER, LLM_API_KEY é reaproveitada.
EMBEDDING_API_KEY=

# --- Perfil alternativo: tudo pela OpenAI (nenhuma chave Anthropic necessária) ---
# Nenhum SPEC depende da Anthropic: todo acesso a LLM passa por common/llm_client.py.
# Modelos da família 4.1 porque os SPECs exigem controle de temperatura
# (0.1-0.3 no fluxo normal, 0.9 apenas na Geração Exploratória / P3).
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
# LLM_MODEL_EXPLORATORY=gpt-4.1

# --- Perfil de teste: sem nenhuma chave ---
# LLM_PROVIDER=mock
# EMBEDDING_PROVIDER=mock

# --- GitHub (opcional) ---
# Preenchidos, o Executor abre PR de verdade e a Homologação mergeia pelo PR.
# Vazios, tudo continua local - que é o padrão desta PoC.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Executor: quem planeja, escreve e revisa código ---
# O funil (LLM_MODEL) classifica texto curto e pode ser um modelo pequeno.
# Escrever código não: com o modelo do funil, uma entrega passou em todos os
# gates sem fazer nada. O revisor é de propósito um modelo diferente do
# que escreveu - mesmos pontos cegos aprovam o próprio erro.
# Vazios, ambos caem em LLM_MODEL.
LLM_MODEL_CODE=gpt-5.3-codex
LLM_MODEL_REVIEW=gpt-5.5
# low | medium | high - só vale para modelos de raciocínio (gpt-5*, o3, o4)
REASONING_EFFORT_PLANNING=high
REASONING_EFFORT_CODE=medium
REASONING_EFFORT_REVIEW=high
